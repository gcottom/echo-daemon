{
  "name": "EchoDaemon",
  "description": "Youtube Music Request Interceptor",
  "version": "1.0.0",
  "manifest_version": 3,
  "minimum_chrome_version": "101",
  "permissions": [
    "webRequest"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "128.png"
  }
}
